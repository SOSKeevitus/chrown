  const date = new Date().toLocaleDateString('et-EE');
  vault.history.unshift({
    date,
    amount: delta,
    note: noteInput.value.trim() || (sign > 0 ? 'Raha sissemakse' : 'Raha väljamakse')
  });

  save();
  render();
}

function escapeHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function render() {
  renderSidebar();
  renderMain();
}

newVaultBtn.onclick = () => {
  isCreating = true;
  render();
};

render();
</script>
</body>
</html>